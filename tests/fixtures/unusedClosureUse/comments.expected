<?php

$inside = function () use (/* the only one */ $a) {
    return 1;
};
$after = function () use ($a) /* kept */ {
    return 1;
};
$between = function () use ( /* unused */ $b) {
    return $b;
};
$lineComments = function () use (
    // unused
    $b, // used
) {
    return $b;
};
$beforeUse = function () /* before */ {
    return 1;
};
