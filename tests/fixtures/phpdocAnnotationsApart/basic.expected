$text = 'text /** not a doc comment @param */';

class Entity
{
    /**
     * The identifier.
     *
     * @var int
     */
    private int $id;

    /**
     * @ORM\Column(
     *     type="string",
     *     nullable=true
     * )
     * @var string
     */
    private string $name;

    public function run(): void
    {
        $filter = array_filter(
            [],
            /**
             * Keeps the active items.
             *
             * @param array<string, mixed> $item
             */
            static fn (array $item): bool => $item['active']
        );
        /** One-line description. @var int */
        $limit = 10;
    }
}

final class SharedLine
{
    /**
     * @ORM\Id @ORM\GeneratedValue
     * @ORM\Column(type="integer")
     * @var int
     */
    private int $id;
}
