class Repository
{
    /**
     * @throws Alpha
     * @throws beta
     */
    public function sorted(): void
    {
        array_map(
            /**
             * @throws ZException
             * @throws aException
             */
            function (int $item) {
                return /** @throws B */ fn () => throw new B("item $item");
            },
            []
        );
    }

    /**
     * @throws Second
     * @throws First
     */
    // dresscode keeps this comment
    #[Pure]
    public function withAttribute(): void
    {
        $handlers = [
            /**
             * @throws Ŝtrange
             * @throws Normal
             */
            static fn () => null,
        ];
    }

    /**
     * @throws OnlyOne
     */
    public function single(): void
    {
    }
}
