<?php

try {
    foo();
} catch (RuntimeException | InvalidArgumentException $e) {
} catch (\Throwable|\Exception /* inner */ | LogicException) {
} catch (B | a | C $e) {
} catch (Zend\Exception | App\Exception\Foo | \App\Bar $e) {
} catch (Single $e) {
} catch (Already | Sorted $e) {
