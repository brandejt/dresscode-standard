{
    "name": "brandejt/dresscode-standard",
    "description": "Coding standard for DressCode: a plugin with rules of its own and presets, PER Coding Style with a stricter layout and the hygiene of the code",
    "type": "library",
    "keywords": ["dresscode", "coding standard", "code style", "php"],
    "license": "MIT",
    "authors": [
        {
            "name": "Tomáš Brandejs",
            "email": "brandejt@gmail.com"
        }
    ],
    "config": {
        "sort-packages": true
    },
    "require": {
        "php": "^8.4",
        "dresscode/dresscode": "^1.3"
    },
    "require-dev": {
        "nette/tester": "^2.7",
        "php-parallel-lint/php-parallel-lint": "^1.4",
        "phpstan/phpstan": "^2.3"
    },
    "autoload": {
        "psr-4": {"Brandejt\\DressCodeStandard\\": "src/"}
    },
    "extra": {
        "dresscode": {
            "plugin": "Brandejt\\DressCodeStandard\\Plugin"
        }
    }
}
